import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int k = sc.nextInt();
        int n = sc.nextInt();
        int w = sc.nextInt();

        int totalCost = k * w * (w + 1) / 2;
        int borrow = totalCost - n;

        if (borrow > 0) {
            System.out.println(borrow);
        } else {
            System.out.println(0);
        }

        sc.close();
    }
}
